{
  "name": "agent",
  "version": "0.3.0",
  "description": "A small agentic coding harness with a terminal UI for OpenAI-compatible endpoints",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "openai": "^7.51.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "agent": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  }
}
